# A tiny house: a box with a pitched roof (quads for walls and slopes, triangles for the gables).
# Used to check the OBJ reader on polygons mixing quads and triangles.
v -1 0 -1
v  1 0 -1
v  1 1 -1
v -1 1 -1
v -1 0  1
v  1 0  1
v  1 1  1
v -1 1  1
v  0 1.8 -1
v  0 1.8  1
vt 0 0
vn 0 0 1
f 5/1/1 6/1/1 7/1/1 8/1/1
f 2//1 1//1 4//1 3//1
f 6 2 3 7
f 1 5 8 4
f 1 2 6 5
f 4 8 10 9
f 7 3 9 10
f 8 7 10
f 3 4 9
